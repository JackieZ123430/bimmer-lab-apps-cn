{
  "schema": 1,
  "components": [
    {
      "id": "cluster_themes",
      "kind": "app",
      "path": "apps/cluster_themes",
      "manifest": "app.zh-CN.json",
      "title": "仪表主题",
      "description": "在仪表中选择主题、驾驶模式外观、数据显示和导航地图布局。",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "cluster-render": "0.5.1"
      },
      "icon": "icon.png",
      "build": {
        "python": "localization/build_zh_cn.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit",
          "apps",
          "localization"
        ]
      }
    }
  ],
  "tools": []
}
